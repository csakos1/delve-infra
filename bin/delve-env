#!/bin/sh
# Write /etc/delve/env (root:delve 0640) from a dev env file, switching the database to the
# production `delve` DB (peer auth as the `delve` user). Other keys are kept as they are.
#   sudo bin/delve-env ~/.config/delve/dev.env
# Refuses to overwrite an existing /etc/delve/env unless FORCE=1. Push settings (FCM_*,
# PUSH_*) already in /etc/delve/env are kept unless the dev file sets them.
set -eu
SRC=${1:?usage: delve-env <dev.env>}
DEST=/etc/delve/env
[ "$(id -u)" -eq 0 ] || { echo "delve-env: run with sudo" >&2; exit 1; }
[ -r "$SRC" ] || { echo "delve-env: cannot read $SRC" >&2; exit 1; }
id delve >/dev/null 2>&1 || { echo "delve-env: no 'delve' user yet (systemd-sysusers)" >&2; exit 1; }
if [ -e "$DEST" ] && [ "${FORCE:-0}" != 1 ]; then
  echo "delve-env: $DEST exists (FORCE=1 to replace)" >&2; exit 1
fi
for key in HERMES_API_KEY HERMES_THINK_MODEL; do
  grep -q "^$key=." "$SRC" || { echo "delve-env: $key missing in $SRC" >&2; exit 1; }
done
# The dev file is shell (`set -a; . file`), so values like $HOME/... are expanded here,
# as the invoking user; systemd's EnvironmentFile would take them literally.
OWNER_HOME=$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)
keys=$(sed -n 's/^\([A-Z_][A-Z0-9_]*\)=.*/\1/p' "$SRC" | grep -v -x DELVE_DATABASE_URL)
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
{
  echo "# generated by delve-infra bin/delve-env from $SRC on $(date -I)"
  echo "DELVE_DATABASE_URL=postgresql+asyncpg:///delve?host=/run/postgresql"
  env -i HOME="$OWNER_HOME" PATH=/usr/bin:/bin sh -ec '
    set -a; . "$1"; set +a; shift
    for k in "$@"; do eval "v=\${$k}"; printf "%s=%s\n" "$k" "$v"; done' sh "$SRC" $keys
  if [ -r "$DEST" ]; then
    for line in $(grep -E '^(FCM|PUSH)_[A-Z0-9_]*=' "$DEST" || true); do
      printf '%s\n' "$keys" | grep -q -x "${line%%=*}" || printf '%s\n' "$line"
    done
  fi
} > "$tmp"
if grep -v '^#' "$tmp" | grep -q '[$`"'"'"'\\ ]'; then
  echo "delve-env: a value still contains \$, quotes, backslashes or spaces:" >&2
  grep -v '^#' "$tmp" | grep '[$`"'"'"'\\ ]' | sed 's/^\(HERMES_API_KEY=\).*/\1<hidden>/' >&2
  exit 1
fi
install -d -m 0750 -o root -g delve /etc/delve
install -m 0640 -o root -g delve "$tmp" "$DEST"
echo "delve-env: wrote $DEST:"
sed 's/^\(HERMES_API_KEY=\).*/\1<hidden>/' "$DEST"
