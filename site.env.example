# Copy to site.env (gitignored) and fill in from: ls -l /dev/disk/by-id/ | grep -v -- -part
# Disks the agent may query with smartctl (-H, -a, -a -j).
DISK_1=nvme-EXAMPLE_SYSTEM_DISK_SERIAL
DISK_2=nvme-EXAMPLE_SECOND_DISK_SERIAL
DISK_3=ata-EXAMPLE_SATA_DISK_SERIAL
DISK_4=ata-EXAMPLE_SATA_DISK_SERIAL
