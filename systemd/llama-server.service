[Unit]
Description=llama.cpp server (the model preset ~/.config/delve/llama/active.env points to)
After=network.target

[Service]
# The model and all that depends on it (context, GPU split, KV cache, sampling, projector)
# come from the active preset: LLAMA_ARG_* variables that llama-server reads itself, plus
# LLAMA_EXTRA_ARGS for switches that take no value (llama/presets/, D-49). What must not
# vary with the model stays here on the command line, which wins over the environment.
EnvironmentFile=%h/.config/delve/llama/active.env
ExecStart=%h/src/llama.cpp/build/bin/llama-server $LLAMA_EXTRA_ARGS \
  --host 127.0.0.1 --port 8080 -np 1 --jinja --metrics
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
