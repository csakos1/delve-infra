# One instance per connection of delve-helper.socket. Runs bin/delve-helper as root with
# fixed verbs only (llama.status|start|stop, hermes.status, gpu.status), no arguments.
# Install: bin/delve-helper -> /usr/local/lib/delve/delve-helper (root 0755),
#          etc/delve/helper.env.example -> /etc/delve/helper.env (edit LLAMA_USER).
# Not set on purpose: PrivateDevices (nvidia-smi needs /dev/nvidia*) and PrivateUsers
# (systemctl reaches the user managers through the system manager as uid 0).
[Unit]
Description=Delve privileged helper (one request)
CollectMode=inactive-or-failed

[Service]
User=root
EnvironmentFile=/etc/delve/helper.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/delve/delve-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=40
MemoryMax=256M
TasksMax=32

UMask=0077
# root without capabilities: the system manager authorizes uid 0 itself, the NVIDIA device
# nodes are world-readable; if a verb answers "permission denied", see the README (step 16)
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
