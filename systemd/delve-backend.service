# Delve backend: system unit, user `delve`, 127.0.0.1:8700 (decisions 96-98).
# Install: /etc/systemd/system/delve-backend.service; the code comes from
# delve-backend/deploy/install.sh (/opt/delve/current), settings from /etc/delve/env.
# Hermes and llama-server are user units of other users and cannot be ordered against;
# the backend polls them and recovers on its own.
#
# Later steps add drop-ins instead of editing this file:
#   B2    cards:  BindReadOnlyPaths=/home/agent/.hermes/cards:/run/delve/cards - delve-backend.service.d/cards.conf
#   B1    FCM:    outbound HTTPS to Google (IPAddressDeny below) - delve-backend.service.d/fcm.conf
#   B3    system: no change here - privileged verbs go through delve-helper.socket
#         (/run/delve-helper.sock, group delve); this unit keeps sudo and devices out
#   B6    inbox:  ReadWritePaths=-/var/lib/delve-inbox (attachment files) - delve-backend.service.d/inbox.conf

[Unit]
Description=Delve backend
Documentation=https://github.com/csakos1/delve-backend
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=delve
Group=delve
EnvironmentFile=/etc/delve/env
WorkingDirectory=/opt/delve/current
ExecStart=/opt/delve/current/venv/bin/delve-backend serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StateDirectory=delve
RuntimeDirectory=delve
UMask=0027

# --- hardening -----------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# loopback only: Hermes, llama-server, tailscale serve's proxy; PostgreSQL is a unix socket
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
