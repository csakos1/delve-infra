# /etc/delve/helper.env (root:root 0644) - read by delve-helper@.service.
# The user that runs llama-server as a user unit (the operator), the agent user, and the
# agent's `hermes` executable (`command -v hermes` as the agent user; for agent.incidents).
LLAMA_USER=operator
LLAMA_UNIT=llama-server
AGENT_USER=agent
HERMES_UNIT=hermes-gateway
HERMES_BIN=/home/agent/.local/bin/hermes
