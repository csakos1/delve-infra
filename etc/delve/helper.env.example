# /etc/delve/helper.env (root:root 0644) - read by delve-helper@.service.
# The user that runs llama-server as a user unit (the operator), the agent user, and the
# agent's `hermes` executable (`command -v hermes` as the agent user; for the agent.* verbs).
LLAMA_USER=operator
LLAMA_UNIT=llama-server
AGENT_USER=agent
HERMES_UNIT=hermes-gateway
HERMES_BIN=/home/agent/.local/bin/hermes
# The agent's Hermes home (agent.cron.list reads cron/jobs.json there); default /home/<AGENT_USER>/.hermes
#AGENT_HERMES_HOME=/home/agent/.hermes
# The model presets of llama-server (llama.models, llama.select); default
# /home/<LLAMA_USER>/.config/delve/llama
#LLAMA_PRESET_DIR=/home/operator/.config/delve/llama
# The context a preset needs to be usable: the window Hermes is configured with
# (`context_length` in hermes/config.fragments.yaml). Default and lower bound 65536.
#LLAMA_MIN_CTX=131072
