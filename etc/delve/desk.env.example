# ~/.config/delve/desk.env (the operator's, mode 0600) - read by delve-desk.service.
# The agent's token: `sudo delve token create --name desk --role desk` prints it once.
# It opens one route of the backend (GET /api/v1/desk/next) and nothing else.
DELVE_DESK_TOKEN=paste-the-printed-token-here
# The backend on the loopback; only an http://127.0.0.1 (or localhost) address is accepted.
#DELVE_DESK_URL=http://127.0.0.1:8700
