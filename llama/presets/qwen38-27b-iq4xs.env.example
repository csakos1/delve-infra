# Model preset for systemd/llama-server.service: copy to
# /home/<operator>/.config/delve/llama/qwen38-27b-iq4xs.env (without ".example"), fill in
# the paths, and point active.env at it:
#   ln -sfn qwen38-27b-iq4xs.env ~/.config/delve/llama/active.env
#
# A systemd EnvironmentFile: KEY=VALUE, absolute paths, no variable expansion.
# The file name (lowercase letters, digits, . _ -) is the preset's name.
#
# Qwen3.8-27B, Unsloth UD-IQ4_XS: 96K context on 12 GB + 8 GB, layer split 38:26,
# q8_0 KV cache, the projector on the CPU (D-03).

# --- for Delve (all optional) ---
# DELVE_LABEL: shown instead of the name taken from the model's file name
# DELVE_NOTE: one line under the model in the picker
# DELVE_THINKING: toggle (thinking can be switched per chat) | always | none
DELVE_THINKING=toggle

# --- for llama-server (`llama-server --help` names the variable of each option) ---
LLAMA_ARG_MODEL=/home/<operator>/models/qwen38/Qwen3.8-27B-UD-IQ4_XS.gguf
LLAMA_ARG_MMPROJ=/home/<operator>/models/qwen38/mmproj-BF16.gguf
# at least 65536: Hermes needs a 64K window (D-04); smaller presets are listed as unusable
LLAMA_ARG_CTX_SIZE=98304
LLAMA_ARG_N_GPU_LAYERS=99
LLAMA_ARG_SPLIT_MODE=layer
LLAMA_ARG_TENSOR_SPLIT=38,26
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_TEMPERATURE=1.0
LLAMA_ARG_TOP_P=0.95
LLAMA_ARG_TOP_K=20
LLAMA_ARG_MIN_P=0
# switches without a value; keep the line even when it is empty
LLAMA_EXTRA_ARGS=--no-mmproj-offload
